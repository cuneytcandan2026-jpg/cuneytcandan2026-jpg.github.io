{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Laara Digital Brand Tokens",
  "version": "3.0.0",
  "updated": "2026-08-09",
  "companion": "LAARA_Digital_Brand_Guidelines_v3.md",

  "_accessibilityWarning": {
    "summary": "Brand green #12B76A FAILS WCAG contrast against white and paper (2.62:1). Safe only as a background behind ink text, or as text on ink.",
    "rules": [
      "Green button MUST use ink #101114 text (7.20:1, AAA). Never white (2.62:1, FAIL).",
      "Green text on light backgrounds MUST use color.greenText #0D844D (4.75:1, AA) or greenDeep #0A633A (7.35:1, AAA).",
      "Muted grey #8A8F98 is 3.25:1 — large text (18.66px bold / 24px regular) and non-text UI only.",
      "The logo's green dot is exempt — WCAG text-contrast rules do not apply to logotypes."
    ]
  },

  "color": {
    "brand": {
      "ink":   { "value": "#101114", "type": "color", "description": "Primary — wordmark, headlines, body text, dark surfaces" },
      "green": { "value": "#12B76A", "type": "color", "description": "Accent — the dot, buttons, highlights. See accessibility warning." },
      "paper": { "value": "#FAFAF9", "type": "color", "description": "Primary light background" },
      "white": { "value": "#FFFFFF", "type": "color", "description": "Clean base, cards, reversed content" }
    },
    "greenScale": {
      "_note": "Green darkens TOWARD ink, so darker button states REDUCE contrast with ink text. #0E8E52 is the floor — any darker and ink text drops below 4.5:1. Do not darken hover/active further.",
      "hover":  { "value": "#0FA05D", "type": "color", "description": "Button hover — ink text 5.58:1 (AA)" },
      "active": { "value": "#0E9455", "type": "color", "description": "Button pressed — ink text 4.84:1 (AA)" },
      "floor":  { "value": "#0E8E52", "type": "color", "description": "Darkest green that still carries ink text at 4.50:1. Do not go below." },
      "text":   { "value": "#0D844D", "type": "color", "description": "Green TEXT on light backgrounds — 4.75:1 white, 4.54:1 paper (AA)" },
      "deep":   { "value": "#0A633A", "type": "color", "description": "Green TEXT, AAA — 7.35:1 white, 7.03:1 paper" }
    },
    "neutral": {
      "textGrey":  { "value": "#6E747D", "type": "color", "description": "Secondary body text — 4.71:1 on white (AA)" },
      "mutedGrey": { "value": "#8A8F98", "type": "color", "description": "3.25:1 — LARGE TEXT and non-text UI only" },
      "border":    { "value": "#E4E4E1", "type": "color", "description": "Dividers, card borders, table rules" },
      "surface":   { "value": "#F3F3F1", "type": "color", "description": "Subtle section fills on light backgrounds" },
      "onDarkMuted":  { "value": "rgba(250,250,249,0.70)", "type": "color", "description": "Secondary text on ink" },
      "onDarkSubtle": { "value": "rgba(250,250,249,0.55)", "type": "color", "description": "Tertiary text on ink" }
    },
    "semantic": {
      "bg":             { "value": "{color.brand.paper}", "type": "color" },
      "bgAlt":          { "value": "{color.brand.white}", "type": "color" },
      "bgInverse":      { "value": "{color.brand.ink}", "type": "color" },
      "text":           { "value": "{color.brand.ink}", "type": "color" },
      "textSecondary":  { "value": "{color.neutral.textGrey}", "type": "color" },
      "textInverse":    { "value": "{color.brand.paper}", "type": "color" },
      "link":           { "value": "{color.greenScale.text}", "type": "color" },
      "linkOnDark":     { "value": "{color.brand.green}", "type": "color" },
      "accent":         { "value": "{color.brand.green}", "type": "color" },
      "onAccent":       { "value": "{color.brand.ink}", "type": "color", "description": "MUST be ink. Never white." },
      "focusRing":      { "value": "{color.brand.ink}", "type": "color" },
      "focusRingDark":  { "value": "{color.brand.green}", "type": "color" }
    }
  },

  "contrastMatrix": {
    "_note": "Calculated from the WCAG 2.2 relative-luminance formula. AA needs 4.5:1 normal text, 3:1 large text and non-text UI.",
    "pass": [
      { "fg": "#101114", "bg": "#FFFFFF", "ratio": 18.88, "level": "AAA" },
      { "fg": "#101114", "bg": "#FAFAF9", "ratio": 18.08, "level": "AAA" },
      { "fg": "#FFFFFF", "bg": "#101114", "ratio": 18.88, "level": "AAA" },
      { "fg": "#FAFAF9", "bg": "#101114", "ratio": 18.08, "level": "AAA" },
      { "fg": "#101114", "bg": "#12B76A", "ratio": 7.20,  "level": "AAA", "note": "The button pairing" },
      { "fg": "#12B76A", "bg": "#101114", "ratio": 7.20,  "level": "AAA", "note": "Green text on dark" },
      { "fg": "#0A633A", "bg": "#FFFFFF", "ratio": 7.35,  "level": "AAA" },
      { "fg": "#0D844D", "bg": "#FFFFFF", "ratio": 4.75,  "level": "AA" },
      { "fg": "#0D844D", "bg": "#FAFAF9", "ratio": 4.54,  "level": "AA" },
      { "fg": "#6E747D", "bg": "#FFFFFF", "ratio": 4.71,  "level": "AA" },
      { "fg": "#6E747D", "bg": "#FAFAF9", "ratio": 4.51,  "level": "AA" }
    ],
    "largeTextOnly": [
      { "fg": "#8A8F98", "bg": "#FFFFFF", "ratio": 3.25 },
      { "fg": "#8A8F98", "bg": "#FAFAF9", "ratio": 3.11 }
    ],
    "fail": [
      { "fg": "#12B76A", "bg": "#FFFFFF", "ratio": 2.62, "note": "Never use green text on white" },
      { "fg": "#12B76A", "bg": "#FAFAF9", "ratio": 2.51, "note": "Never use green text on paper" },
      { "fg": "#FFFFFF", "bg": "#12B76A", "ratio": 2.62, "note": "Never use white text on a green button" }
    ]
  },

  "typography": {
    "family": {
      "base":     { "value": "Lato, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "type": "fontFamily" },
      "logoOnly": { "value": "Archivo Black", "type": "fontFamily", "description": "LOGO ARTWORK ONLY — do not load or use as web type" }
    },
    "weight": {
      "regular":  { "value": 400, "type": "fontWeight" },
      "semibold": { "value": 600, "type": "fontWeight" },
      "bold":     { "value": 700, "type": "fontWeight" },
      "black":    { "value": 900, "type": "fontWeight" }
    },
    "size": {
      "display": { "value": "clamp(2.5rem, 1.40rem + 4.9vw, 5rem)",      "min": "40px", "max": "80px" },
      "h1":      { "value": "clamp(2.125rem, 1.45rem + 3.0vw, 3.5rem)",  "min": "34px", "max": "56px" },
      "h2":      { "value": "clamp(1.75rem, 1.40rem + 1.5vw, 2.625rem)", "min": "28px", "max": "42px" },
      "h3":      { "value": "clamp(1.375rem, 1.25rem + 0.5vw, 1.75rem)", "min": "22px", "max": "28px" },
      "bodyLg":  { "value": "clamp(1.0625rem, 1.02rem + 0.2vw, 1.25rem)","min": "17px", "max": "20px" },
      "body":    { "value": "1rem",     "note": "16px minimum — do not go below" },
      "small":   { "value": "0.875rem", "note": "14px" }
    },
    "lineHeight": {
      "display": { "value": 1.02 },
      "heading": { "value": 1.15 },
      "body":    { "value": 1.6 },
      "tight":   { "value": 1.25 }
    },
    "measure": { "value": "68ch", "description": "Max paragraph width, ~60-72 characters" }
  },

  "space": {
    "1":  { "value": "0.25rem" },
    "2":  { "value": "0.5rem" },
    "3":  { "value": "0.75rem" },
    "4":  { "value": "1rem" },
    "6":  { "value": "1.5rem" },
    "8":  { "value": "2rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" },
    "24": { "value": "6rem" },
    "32": { "value": "8rem" },
    "sectionY": { "value": "clamp(3.5rem, 2.2rem + 5.5vw, 7.5rem)" },
    "pageX":    { "value": "clamp(1.5rem, 0.9rem + 2.6vw, 5rem)" }
  },

  "layout": {
    "contentMax":       { "value": "1280px" },
    "headerHeight":     { "value": "64px" },
    "headerHeightDesktop": { "value": "72px" },
    "grid": { "desktop": 12, "tablet": 8, "mobile": 4 }
  },

  "radius": {
    "sm":   { "value": "4px" },
    "base": { "value": "8px",  "description": "Buttons, inputs" },
    "card": { "value": "10px" },
    "lg":   { "value": "16px", "description": "Feature cards" },
    "iconTile": { "value": "24%", "description": "Proportional — icon container tiles" },
    "logoDot":  { "value": "22%", "description": "The green dot's corner radius, as a fraction of its size" }
  },

  "shadow": {
    "sm":   { "value": "0 1px 2px rgba(16,17,20,0.06)" },
    "base": { "value": "0 4px 16px rgba(16,17,20,0.08)" },
    "lg":   { "value": "0 12px 32px rgba(16,17,20,0.12)" }
  },

  "motion": {
    "duration": {
      "micro":   { "value": "180ms", "description": "Hover, micro-interaction" },
      "reveal":  { "value": "280ms", "description": "Card and menu reveal" },
      "section": { "value": "500ms", "description": "Section entrance" }
    },
    "easing": {
      "out":   { "value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "inOut": { "value": "cubic-bezier(0.65, 0, 0.35, 1)" }
    },
    "_note": "Always respect prefers-reduced-motion. Never animate the logo's DIGITAL slices."
  },

  "control": {
    "minHeight":     { "value": "48px", "description": "Buttons and inputs" },
    "touchTarget":   { "value": "44px", "description": "WCAG 2.2 minimum target size" },
    "focusRingWidth":{ "value": "3px" },
    "focusRingOffset":{ "value": "2px" }
  },

  "logo": {
    "_tierRule": "The mark reduces progressively. DIGITAL is dropped before it becomes illegible.",
    "tiers": [
      { "tier": 1, "name": "Primary", "minWidth": "200px", "shows": "laara. + DIGITAL", "file": "01_Logos/laara-primary.svg" },
      { "tier": 2, "name": "Compact", "range": "80-200px", "shows": "laara.",           "file": "01_Logos/laara-compact.svg" },
      { "tier": 3, "name": "Icon",    "range": "below 80px", "shows": "la.",            "file": "02_Icons/icon-ink.svg" },
      { "tier": 4, "name": "Favicon", "range": "16-32px", "shows": "the dot alone",     "file": "11_Favicon_32px_Simplified/favicon-32px-simplified.svg" }
    ],
    "clearSpace": { "value": "1X", "description": "X = the width of the green dot. Use 2X in website headers." },
    "headerUsage": {
      "tier": 2,
      "css": "width: clamp(110px, 12vw, 150px); height: auto; max-height: 40px;",
      "note": "Header uses the COMPACT mark. At 40px max height, DIGITAL would render ~7px tall and turn to mush."
    },
    "assetPack": "Laara Logo Final/00_Upload_Ready/"
  },

  "brand": {
    "nameInCopy": { "value": "Laara Digital", "note": "Sentence case. Never LAARA in body text. Lowercase 'laara.' is logo artwork only." },
    "domain":     { "value": "laaradigital.co.uk" },
    "email":      { "value": "hello@laaradigital.co.uk" },
    "handle":     { "value": "@laaradigital" },
    "tagline":    { "value": null, "note": "v3 removed the tagline. Lead with the promise: 'Get found online. Get more enquiries.'" }
  }
}
